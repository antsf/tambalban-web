{
  "name": "tambalban-web-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build": "npm run build:css && npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/tailwind.css --minify",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text --coverage.thresholds.lines=55",
    "test:ci": "node --test ../scripts/ci.test.mjs ../scripts/release-notes.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "hono": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@vitest/coverage-v8": "4.1.10",
    "basecoat-css": "1.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^3.90.0"
  }
}
